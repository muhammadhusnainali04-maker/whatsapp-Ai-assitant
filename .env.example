# --- Shared secret n8n uses to call this backend ---
WEBHOOK_API_KEY=change-me-to-a-long-random-string

# --- Groq ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.4
GROQ_TOP_P=0.9
GROQ_MAX_OUTPUT_TOKENS=512
GROQ_TIMEOUT_SECONDS=15

# --- App1Transcribe ---
APP1TRANSCRIBE_API_KEY=your-app1transcribe-api-key
APP1TRANSCRIBE_URL=https://api.app1transcribe.example/v1/transcribe

# --- WhatsApp Cloud API (Meta test number — see README) ---
WHATSAPP_ACCESS_TOKEN=your-temporary-or-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-test-number-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-string-you-choose-must-match-meta-webhook-config

# --- Database ---
DATABASE_PATH=./database/app.db

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
